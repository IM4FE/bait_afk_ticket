# Настройки бота
BOT_TOKEN=

# Настройки PostgreSQL для самого контейнера БД
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=tg_bot_bait_afk_ticket_db

# Строка подключения для SQLAlchemy (хост "db" совпадает с именем сервиса в docker-compose.yml)
DB_URL=postgresql+asyncpg://type_user_here:type_password_here@db:5432/tg_bot_bait_afk_ticket_db
